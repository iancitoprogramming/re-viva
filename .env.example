# ─── Base de datos PostgreSQL (Supabase) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:6543/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/db"   # Para prisma migrate

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="cambiar_por_string_aleatorio_minimo_32_chars"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ─── Trainer ─────────────────────────────────────────────────────────────────
TRAINER_EMAIL="ian@igztrainer.com"
ADMIN_EMAILS="ian@igztrainer.com"   # Comma-separated. Define acceso a /admin

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/settings/account/credentials
MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MP_WEBHOOK_SECRET=""     # Configurar en MP > Webhooks > Clave secreta

# ─── App (necesario para back_urls de Mercado Pago) ──────────────────────────
NEXT_PUBLIC_BASE_URL="https://re-viva.vercel.app"      # Sin trailing slash
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"  # Igual que MP_PUBLIC_KEY
