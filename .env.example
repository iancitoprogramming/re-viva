# ─── Base de datos PostgreSQL (Supabase) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:6543/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/db"   # Para prisma migrate

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="cambiar_por_string_aleatorio_minimo_32_chars"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Todo src/lib/email.ts manda por Resend. Sin estas dos variables NINGÚN mail
# sale: ni recuperación de contraseña, ni credenciales de cliente, ni avisos
# al trainer, ni los crons.
# RESEND_FROM_EMAIL tiene que ser una dirección de un dominio verificado en
# Resend; si no, la API rechaza el envío.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="REVIVA IGZ <noreply@revivabyigz.com>"

# ─── Trainer y admin ─────────────────────────────────────────────────────────
TRAINER_EMAIL="ian@igztrainer.com"          # Destino de las notificaciones
ADMIN_EMAILS="ian@igztrainer.com"           # Comma-separated. Define acceso a /admin
REVIVA_CONTACT_EMAIL="hola@igztrainer.com"  # Email de contacto público

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/settings/account/credentials
MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MP_WEBHOOK_SECRET=""     # Configurar en MP > Webhooks > Clave secreta

# ─── App (necesario para back_urls de Mercado Pago) ──────────────────────────
NEXT_PUBLIC_BASE_URL="https://re-viva.vercel.app"      # Sin trailing slash
NEXT_PUBLIC_MP_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"  # Igual que MP_PUBLIC_KEY

# ─── WebAuthn (login con passkey / huella) ───────────────────────────────────
WEBAUTHN_RPID="re-viva.vercel.app"            # Dominio, sin protocolo
WEBAUTHN_ORIGIN="https://re-viva.vercel.app"  # Con protocolo

# ─── Crons de Vercel ─────────────────────────────────────────────────────────
# Vercel manda este valor como `Authorization: Bearer <CRON_SECRET>` al invocar
# los crons de vercel.json. Si falta, /api/cron/* responde 503 (fail-closed).
CRON_SECRET="string_aleatorio"

# ─── Vercel Blob (archivos de clientes en el back office) ────────────────────
REVIVA_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ─── IA (generación de templates y planes) ───────────────────────────────────
GEMINI_API_KEY="AIza..."      # api/admin/templates/generar-ia
ANTHROPIC_API_KEY="sk-ant-..."
