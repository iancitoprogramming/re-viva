// Re-Viva by IGZ Trainer - Esquema de base de datos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ────────────────────────────────────────────────────────────────
model User {
  id        String    @id @default(cuid())
  nombre    String
  email     String    @unique
  password  String
  creadoEn  DateTime  @default(now())
  deletedAt DateTime? // Soft delete — no se elimina de la DB

  perfil      NutritionalProfile?
  plan        NutritionalPlan?
  resetTokens ResetToken[]
  payments    Payment[]
  checkIns    CheckIn[]
  archivos    Archivo[]
  mealPlans   MealPlan[]

  planGenerations   PlanGeneration[]
  pendingReviews    PendingTrainerReview[]
  plansToRegenerate PlanToRegenerate[]
}

// ─── CATÁLOGO DE ALIMENTOS ───────────────────────────────────────────────────
// Macros expresados por 100 g (o 100 ml para líquidos). El trainer puede ajustar.
model Food {
  id          String       @id @default(cuid())
  nombre      String       @unique
  categoria   FoodCategoria
  unidad      String       @default("g") // "g" | "ml" | "unidad"
  // Macros por 100 g/ml
  kcal        Float
  proteina    Float
  hidratos    Float
  grasas      Float
  // Para lista de compras (cómo se compra en la góndola)
  unidadCompra String?     // ej. "kg", "docena", "atado"
  notas       String?
  activo      Boolean      @default(true)
  creadoEn    DateTime     @default(now())
  actualizadoEn DateTime   @updatedAt

  templateItems TemplateMealItem[]
  planItems     PlanMealItem[]
}

enum FoodCategoria {
  PROTEINA_ANIMAL
  PROTEINA_VEGETAL
  LACTEO
  CARBOHIDRATO
  VEGETAL
  FRUTA
  GRASA
  BEBIDA
  CONDIMENTO
  SUPLEMENTO
}

// ─── TEMPLATES DE PLAN ALIMENTARIO ───────────────────────────────────────────
// Plantillas reutilizables que el trainer usa como punto de partida.
model MealPlanTemplate {
  id            String        @id @default(cuid())
  nombre        String
  descripcion   String?
  // Perfil objetivo (para sugerencia automática al trainer)
  genero        Genero?
  objetivo      Objetivo?
  edadMin       Int?
  edadMax       Int?
  adherencia    Adherencia?
  // Macros target del template (como referencia, recalculados al instanciar)
  kcalTarget    Float
  proteinaTarget Float
  hidratosTarget Float
  grasasTarget  Float
  notas         String?
  generadoConIA Boolean       @default(false)
  activo        Boolean       @default(true)
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  comidas TemplateMeal[]
}

model TemplateMeal {
  id         String  @id @default(cuid())
  templateId String
  nombre     String  // "Desayuno", "Almuerzo", etc.
  orden      Int
  horaSugerida String?

  template MealPlanTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    TemplateMealItem[]
}

model TemplateMealItem {
  id      String @id @default(cuid())
  mealId  String
  foodId  String
  gramos  Float
  notas   String?

  meal TemplateMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food         @relation(fields: [foodId], references: [id])
}

// ─── PLAN ALIMENTARIO ASIGNADO A UN CLIENTE ──────────────────────────────────
// Instancia concreta para un cliente. Se versiona: cada edición crea una nueva
// versión y la anterior queda como ARCHIVADO en el historial.
model MealPlan {
  id            String        @id @default(cuid())
  userId        String
  version       Int           @default(1)
  estado        EstadoMealPlan @default(BORRADOR)
  // Origen
  templateOrigenId String?    // de qué template se partió (si aplica)
  // Macros calculados desde los items
  kcalTotal     Float
  proteinaTotal Float
  hidratosTotal Float
  grasasTotal   Float
  // Macros target que el trainer quiso lograr (referencia)
  kcalTarget    Float?
  proteinaTarget Float?
  hidratosTarget Float?
  grasasTarget  Float?
  notas         String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  comidas     PlanMeal[]
  shoppingList ShoppingList?

  @@index([userId, version])
}

enum EstadoMealPlan {
  BORRADOR
  ACTIVO
  ARCHIVADO
}

model PlanMeal {
  id         String @id @default(cuid())
  mealPlanId String
  nombre     String
  orden      Int
  horaSugerida String?

  mealPlan MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items    PlanMealItem[]
}

model PlanMealItem {
  id     String @id @default(cuid())
  mealId String
  foodId String
  gramos Float
  notas  String?

  meal PlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food     @relation(fields: [foodId], references: [id])
}

// ─── LISTA DE COMPRAS ────────────────────────────────────────────────────────
// Autogenerada agrupando items del MealPlan. Editable por el trainer.
model ShoppingList {
  id         String   @id @default(cuid())
  mealPlanId String   @unique
  diasCubiertos Int   @default(7)
  notas      String?
  creadoEn   DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  mealPlan MealPlan          @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items    ShoppingListItem[]
}

model ShoppingListItem {
  id             String @id @default(cuid())
  shoppingListId String
  nombre         String        // copiado del Food.nombre (puede editarse)
  categoria      FoodCategoria
  cantidad       Float         // total semanal
  unidad         String        // "g", "kg", "ml", "unidad"
  comprado       Boolean       @default(false)

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

// ─── CÓDIGO DE RECUPERACIÓN DE CONTRASEÑA ────────────────────────────────────
model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  codigo    String
  expiresAt DateTime
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── PERFIL NUTRICIONAL ──────────────────────────────────────────────────────
model NutritionalProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  genero            Genero
  edad              Int
  altura            Float
  peso              Float
  objetivo          Objetivo
  diasEntrenamiento Int
  nivelEstres       NivelEstres
  horasSueno        Float
  adherencia        Adherencia
  preferenciasAlimentarias String?
  lesiones          String?
  fechaNacimiento   DateTime?

  // ── Campos extendidos de onboarding ─────────────────────────────────────
  experiencia          String?   // "ninguna"|"principiante"|"intermedio"|"avanzado"
  equipamiento         String[]  @default([]) // ["gym","casa","calistenia","aire_libre"]
  actividadLaboral     String?   // "sedentario"|"activo"|"alto"
  practicaDeportes     Boolean   @default(false)
  deportes             String[]  @default([]) // ["fútbol","running","crossfit",...]
  quiereMejorarDeporte String?
  metasFisicas         String[]  @default([]) // ["perder_grasa","ganar_masa","mejorar_resistencia",...]
  flagsEspeciales      String[]  @default([]) // perimenopausia|embarazo|postparto|lumbar_cronico|adulto_mayor_65plus|deportista_competitivo

  // ── Campos para el motor de generación automática (paso 3 onboarding) ──
  comidasPorDia                 Int       @default(4)
  minutosPorSesion              Int       @default(60)
  alergias                      String[]  @default([])
  intolerancias                 String[]  @default([])
  alimentosQueNoConsume         String[]  @default([])
  condicionesMedicasDeclaradas  String[]  @default([])
  lesionesActuales              String[]  @default([])
  lesionesPasadas               String[]  @default([])
  medicacionActual              String[]  @default([])

  // ── Consentimientos (paso 4 onboarding) ────────────────────────────────
  aceptaTerminosYCondiciones            Boolean   @default(false)
  aceptaPoliticaPrivacidad              Boolean   @default(false)
  aceptaDescargoMedicoYResponsabilidad  Boolean   @default(false)
  confirmaVeracidadDatos                Boolean   @default(false)
  fechaAceptacionConsentimientos        DateTime?
  ipAceptacionConsentimientos           String?

  creadoEn DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── PLAN NUTRICIONAL ────────────────────────────────────────────────────────
model NutritionalPlan {
  id            String         @id @default(cuid())
  userId        String         @unique
  estado        EstadoPlan     @default(PENDIENTE)
  tipoPlan      String?
  activadoEn    DateTime?
  fechaVencimiento DateTime?

  // Valores que el trainer define
  clasificacion Clasificacion?
  calorias      Float?
  proteina      Float?
  hidratos      Float?
  grasas        Float?
  notasTrainer  String?

  // Pre-cálculo del motor IGZ
  igzClasificacion Clasificacion?
  igzCalorias      Float?
  igzProteina      Float?
  igzHidratos      Float?
  igzGrasas        Float?

  // Componentes del proceso integral
  estadoAlimentacion    EstadoEntrega @default(PENDIENTE)
  estadoEntrenamiento   EstadoEntrega @default(PENDIENTE)
  estadoSuplementacion  EstadoEntrega @default(PENDIENTE)
  estadoMealPrep        EstadoEntrega @default(PENDIENTE)
  estadoListaCompras    EstadoEntrega @default(PENDIENTE)

  creadoEn DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── CHECK-IN DIARIO ─────────────────────────────────────────────────────────
// Registro de actividad del cliente — base del sistema de gamificación.
// Anti-trampa: max 1 check-in por tipo por día, timestamp generado en servidor.
model CheckIn {
  id         String   @id @default(cuid())
  userId     String
  tipo       String   // "rutina"|"suplemento"|"peso"|"foto"|"medidas"|"hidratacion"
  fecha      DateTime @default(now())
  nota       String?
  confirmado Boolean  @default(true) // false si es check-in de WA pendiente de confirmar por admin
  creadoEn   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, fecha])
  @@index([userId, tipo])
}

// ─── ARCHIVOS (DOCX, PDF, etc.) ──────────────────────────────────────────────
// El trainer sube archivos — el cliente los puede ver y descargar.
model Archivo {
  id             String   @id @default(cuid())
  userId         String
  nombre         String   // Nombre de display, ej: "Rutina Semana 1"
  tipo           String   // "rutina"|"alimentacion"|"suplementacion"|"meal_prep"|"otro"
  url            String   // URL de Vercel Blob
  nombreOriginal String   // Nombre original del archivo
  tamano         Int      // Tamaño en bytes
  subidoEn       DateTime @default(now())
  subidoPor      String   // Email del admin que subió el archivo

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────
enum Genero {
  MASCULINO
  FEMENINO
}

enum Objetivo {
  VOLUMEN
  DEFINICION
  RECOMPOSICION
}

enum NivelEstres {
  BAJO
  MEDIO
  ALTO
}

enum Adherencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoPlan {
  PENDIENTE
  ACTIVO
  ARCHIVADO
}

enum Clasificacion {
  VOLUMEN
  DEFINICION
  RECOMPOSICION
}

enum EstadoEntrega {
  PENDIENTE
  EN_PROGRESO
  ENTREGADO
}

// ─── PIPELINE DE GENERACIÓN DE PLANES ───────────────────────────────────────
// Registro de cada llamada al motor IA (auditoría y costos).
model PlanGeneration {
  id           String   @id @default(cuid())
  clientId     String
  promptHash   String
  modelUsed    String
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  costUSD      Float    @default(0)
  status       String   // 'success' | 'error' | 'timeout'
  errorMsg     String?
  creadoEn     DateTime @default(now())

  client User                 @relation(fields: [clientId], references: [id])
  review PendingTrainerReview?

  @@index([clientId])
  @@index([creadoEn])
}

// Cola de revisión del trainer antes de entregar el plan al cliente.
model PendingTrainerReview {
  id                     String    @id @default(cuid())
  clientId               String
  planGenerationId       String    @unique
  planJson               Json      // GeneratedPlan completo
  proofreaderReportJson  Json?     // ProofreaderReport (rellena en Paso 4)
  proofreaderStatus      String?   // 'aprobado'|'aprobado_con_observaciones'|'rechazado'
  prioridad              String    // 'alta'|'media'|'baja'
  estado                 String    @default("PENDIENTE") // 'PENDIENTE'|'APROBADO'|'RECHAZADO'
  requiereRevisionManual Boolean   @default(false)
  flagsDetectados        String[]  @default([])
  aprobadoPorTrainerId   String?
  aprobadoAt             DateTime?
  entregadoAt            DateTime?
  observacionesResueltas String[]  @default([])
  modificacionesJson     Json?
  creadoEn               DateTime  @default(now())
  actualizadoEn          DateTime  @updatedAt

  client         User           @relation(fields: [clientId], references: [id])
  planGeneration PlanGeneration @relation(fields: [planGenerationId], references: [id])

  @@index([clientId, estado])
  @@index([prioridad, estado])
}

// Planes rechazados en espera de regeneración automática.
model PlanToRegenerate {
  id            String   @id @default(cuid())
  clientId      String
  originalPlanId String?
  motivoRechazo String
  intentosCount Int      @default(0)
  maxIntentos   Int      @default(2)
  estado        String   @default("PENDIENTE") // 'PENDIENTE'|'EN_PROCESO'|'COMPLETADO'|'FALLIDO'
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId, estado])
}

// ─── PAGO (Mercado Pago) ─────────────────────────────────────────────────────
model Payment {
  id           String   @id @default(cuid())
  userId       String
  planTipo     String
  preferenceId String
  paymentId    String?
  status       String   @default("pending")
  amount       Float
  currency     String   @default("ARS")
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
