// Re-Viva by IGZ Trainer - Esquema de base de datos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ────────────────────────────────────────────────────────────────
model User {
  id       String   @id @default(cuid())
  nombre   String
  email    String   @unique
  password String   // Contraseña encriptada con bcrypt
  creadoEn DateTime @default(now())

  perfil       NutritionalProfile?
  plan         NutritionalPlan?
  resetTokens  ResetToken[]
  payments     Payment[]
}

// ─── CÓDIGO DE RECUPERACIÓN DE CONTRASEÑA ────────────────────────────────────
model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  codigo    String
  expiresAt DateTime
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── PERFIL NUTRICIONAL ──────────────────────────────────────────────────────
model NutritionalProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  genero            Genero
  edad              Int
  altura            Float
  peso              Float
  objetivo          Objetivo
  diasEntrenamiento Int
  nivelEstres       NivelEstres
  horasSueno        Float
  adherencia        Adherencia
  preferenciasAlimentarias String?
  lesiones          String?
  fechaNacimiento   DateTime?   // Para cumpleaños automáticos
  creadoEn          DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── PLAN NUTRICIONAL ────────────────────────────────────────────────────────
model NutritionalPlan {
  id            String         @id @default(cuid())
  userId        String         @unique
  estado        EstadoPlan     @default(PENDIENTE)
  tipoPlan      String?        // Ej: "online-mensual", "on-demand", etc.
  activadoEn    DateTime?
  fechaVencimiento DateTime?   // Se calcula en base al tipoPlan al activar

  // Valores que el trainer define
  clasificacion Clasificacion?
  calorias      Float?
  proteina      Float?
  hidratos      Float?
  grasas        Float?
  notasTrainer  String?

  // Pre-cálculo del motor IGZ
  igzClasificacion Clasificacion?
  igzCalorias      Float?
  igzProteina      Float?
  igzHidratos      Float?
  igzGrasas        Float?

  // Componentes del proceso integral
  estadoAlimentacion    EstadoEntrega @default(PENDIENTE)
  estadoEntrenamiento   EstadoEntrega @default(PENDIENTE)
  estadoSuplementacion  EstadoEntrega @default(PENDIENTE)
  estadoMealPrep        EstadoEntrega @default(PENDIENTE)
  estadoListaCompras    EstadoEntrega @default(PENDIENTE)

  creadoEn DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────
enum Genero {
  MASCULINO
  FEMENINO
}

enum Objetivo {
  VOLUMEN
  DEFINICION
  RECOMPOSICION
}

enum NivelEstres {
  BAJO
  MEDIO
  ALTO
}

enum Adherencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoPlan {
  PENDIENTE
  ACTIVO
  ARCHIVADO
}

enum Clasificacion {
  VOLUMEN
  DEFINICION
  RECOMPOSICION
}

enum EstadoEntrega {
  PENDIENTE
  EN_PROGRESO
  ENTREGADO
}

// ─── PAGO (Mercado Pago) ─────────────────────────────────────────────────────
model Payment {
  id           String   @id @default(cuid())
  userId       String
  planTipo     String
  preferenceId String
  paymentId    String?
  status       String   @default("pending")
  amount       Float
  currency     String   @default("ARS")
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
