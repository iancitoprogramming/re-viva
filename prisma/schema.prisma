// Re-Viva by IGZ Trainer - Esquema de base de datos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ────────────────────────────────────────────────────────────────
model User {
  id        String    @id @default(cuid())
  nombre    String
  email     String    @unique
  password  String
  creadoEn  DateTime  @default(now())
  deletedAt DateTime? // Soft delete — no se elimina de la DB

  perfil      NutritionalProfile?
  plan        NutritionalPlan?
  resetTokens ResetToken[]
  payments    Payment[]
  ebookEntregas EbookEntrega[]
  checkIns    CheckIn[]
  archivos    Archivo[]
  shoppingLists ShoppingList[]

  planGenerations   PlanGeneration[]
  pendingReviews    PendingTrainerReview[]
  plansToRegenerate PlanToRegenerate[]
  webAuthnCredentials WebAuthnCredential[]
  cursosProgreso    CursoProgreso[]
}

// ─── LISTA DE COMPRAS SEMANAL ────────────────────────────────────────────────
// Interna (solo admin). Una lista por cliente por semana del plan. El trainer
// la carga a partir del Documento de Nutrición (los gramajes se calculan fuera
// de la web) y la envía por mail desde /admin/cliente/[id]/compras.
model ShoppingList {
  id            String    @id @default(cuid())
  userId        String
  semana        Int // 1, 2, 3... (una por cada semana del plan)
  notas         String?
  enviadoEn     DateTime? // último envío por mail
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  user  User               @relation(fields: [userId], references: [id])
  items ShoppingListItem[]

  @@unique([userId, semana])
}

model ShoppingListItem {
  id             String          @id @default(cuid())
  shoppingListId String
  nombre         String
  categoria      CategoriaCompra
  cantidad       Float // total de la semana
  unidad         String // "g", "kg", "ml", "unidad"
  comprado       Boolean         @default(false)

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

// Categorías de la lista de compras (orden en que se muestran en el mail).
// Ex FoodCategoria: se conservan los valores viejos para no romper la tabla.
enum CategoriaCompra {
  PROTEINA_ANIMAL
  PROTEINA_VEGETAL
  LACTEO
  CARBOHIDRATO
  VEGETAL
  FRUTA
  GRASA
  BEBIDA
  CONDIMENTO
  SUPLEMENTO
  ALMACEN
}

// ─── CÓDIGO DE RECUPERACIÓN DE CONTRASEÑA ────────────────────────────────────
model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  codigo    String
  expiresAt DateTime
  usado     Boolean  @default(false)
  creadoEn  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── PERFIL NUTRICIONAL ──────────────────────────────────────────────────────
model NutritionalProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  genero            Genero
  edad              Int
  altura            Float
  peso              Float
  objetivo          Objetivo
  diasEntrenamiento Int
  nivelEstres       NivelEstres
  horasSueno        Float
  adherencia        Adherencia
  preferenciasAlimentarias String?
  lesiones          String?
  fechaNacimiento   DateTime?

  // ── Campos extendidos de onboarding ─────────────────────────────────────
  experiencia          String?   // "ninguna"|"principiante"|"intermedio"|"avanzado"
  equipamiento         String[]  @default([]) // ["gym","casa","calistenia","aire_libre"]
  actividadLaboral     String?   // "sedentario"|"activo"|"alto"
  practicaDeportes     Boolean   @default(false)
  deportes             String[]  @default([]) // ["fútbol","running","crossfit",...]
  quiereMejorarDeporte String?
  metasFisicas         String[]  @default([]) // ["perder_grasa","ganar_masa","mejorar_resistencia",...]
  flagsEspeciales      String[]  @default([]) // perimenopausia|embarazo|postparto|lumbar_cronico|adulto_mayor_65plus|deportista_competitivo

  // ── Disponibilidad de domingo (aplica solo para 3x/semana FBEOD) ────────
  disponibilidadDomingo  String   @default("no") // "siempre" | "aveces" | "no"

  // ── Oferta / entregables (cuestionario v2) ───────────────────────────────
  resultadoSonado      String? // qué quiere lograr y para cuándo, en sus palabras
  obstaculos           String[] @default([]) // ver OBSTACULOS en src/lib/cuestionario.ts
  horarioEntrenamiento String? // "manana" | "mediodia" | "tarde" | "noche" — ubica pre/post entreno
  comeAfuera           String   @default("nunca") // "nunca" | "1-2" | "3-5" | "6+" comidas afuera por semana
  lugaresComeAfuera    String[] @default([]) // parrilla|pizzeria|sushi|rotiseria|delivery|comida_rapida|kiosco|comedor_trabajo
  sesionesCocina       String? // "dos" | "una" | "no_cocino" — sesiones de meal prep posibles por semana
  supermercado         String? // "coto" | "carrefour" | "jumbo" | "disco" | "dia" | "changomas" | "chino" | "otro"
  suplementosActuales  String[] @default([])

  // ── Campos para el motor de generación automática (paso 3 onboarding) ──
  comidasPorDia                 Int       @default(4)
  minutosPorSesion              Int       @default(60)
  alergias                      String[]  @default([])
  intolerancias                 String[]  @default([])
  alimentosQueNoConsume         String[]  @default([])
  condicionesMedicasDeclaradas  String[]  @default([])
  lesionesActuales              String[]  @default([])
  lesionesPasadas               String[]  @default([])
  medicacionActual              String[]  @default([])

  // ── Consentimientos (paso 4 onboarding) ────────────────────────────────
  aceptaTerminosYCondiciones            Boolean   @default(false)
  aceptaPoliticaPrivacidad              Boolean   @default(false)
  aceptaDescargoMedicoYResponsabilidad  Boolean   @default(false)
  confirmaVeracidadDatos                Boolean   @default(false)
  fechaAceptacionConsentimientos        DateTime?
  ipAceptacionConsentimientos           String?

  // Si el cliente no aceptó todos los consentimientos en el form, queda
  // en estado "pendiente de hablar en persona / videollamada". El trainer
  // marca como revisado desde el back-office después de la charla.
  consentimientosRevisionPersonal       Boolean   @default(false)
  consentimientosRevisadoPorTrainerEn   DateTime?
  notasRevisionConsentimientos          String?

  creadoEn DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── PLAN NUTRICIONAL ────────────────────────────────────────────────────────
model NutritionalPlan {
  id            String         @id @default(cuid())
  userId        String         @unique
  estado        EstadoPlan     @default(PENDIENTE)
  tipoPlan      String?
  activadoEn    DateTime?
  fechaVencimiento DateTime?

  // Valores que el trainer define
  clasificacion Clasificacion?
  calorias      Float?
  proteina      Float?
  hidratos      Float?
  grasas        Float?
  notasTrainer  String?

  // Pre-cálculo del motor IGZ
  igzClasificacion Clasificacion?
  igzCalorias      Float?
  igzProteina      Float?
  igzHidratos      Float?
  igzGrasas        Float?

  // Componentes del proceso integral
  estadoAlimentacion    EstadoEntrega @default(PENDIENTE)
  estadoEntrenamiento   EstadoEntrega @default(PENDIENTE)
  estadoSuplementacion  EstadoEntrega @default(PENDIENTE)
  estadoMealPrep        EstadoEntrega @default(PENDIENTE)
  estadoListaCompras    EstadoEntrega @default(PENDIENTE)

  creadoEn DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── CHECK-IN DIARIO ─────────────────────────────────────────────────────────
// Registro de actividad del cliente — base del sistema de gamificación.
// Anti-trampa: max 1 check-in por tipo por día, timestamp generado en servidor.
model CheckIn {
  id         String   @id @default(cuid())
  userId     String
  tipo       String   // "rutina"|"suplemento"|"peso"|"foto"|"medidas"|"hidratacion"
  fecha      DateTime @default(now())
  nota       String?
  confirmado Boolean  @default(true) // false si es check-in de WA pendiente de confirmar por admin
  creadoEn   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, fecha])
  @@index([userId, tipo])
}

// ─── ARCHIVOS (DOCX, PDF, etc.) ──────────────────────────────────────────────
// El trainer sube archivos — el cliente los puede ver y descargar.
model Archivo {
  id             String   @id @default(cuid())
  userId         String
  nombre         String   // Nombre de display, ej: "Rutina Semana 1"
  tipo           String   // "rutina"|"alimentacion"|"suplementacion"|"meal_prep"|"otro"
  url            String   // URL de Vercel Blob
  nombreOriginal String   // Nombre original del archivo
  tamano         Int      // Tamaño en bytes
  subidoEn       DateTime @default(now())
  subidoPor      String   // Email del admin que subió el archivo

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────
enum Genero {
  MASCULINO
  FEMENINO
}

enum Objetivo {
  VOLUMEN
  DEFINICION
  RECOMPOSICION
}

enum NivelEstres {
  BAJO
  MEDIO
  ALTO
}

enum Adherencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoPlan {
  PENDIENTE
  ACTIVO
  ARCHIVADO
}

enum Clasificacion {
  VOLUMEN
  DEFINICION
  RECOMPOSICION
}

enum EstadoEntrega {
  PENDIENTE
  EN_PROGRESO
  ENTREGADO
}

// ─── PIPELINE DE GENERACIÓN DE PLANES ───────────────────────────────────────
// Registro de cada llamada al motor IA (auditoría y costos).
model PlanGeneration {
  id           String   @id @default(cuid())
  clientId     String
  promptHash   String
  modelUsed    String
  tokensInput  Int      @default(0)
  tokensOutput Int      @default(0)
  costUSD      Float    @default(0)
  status       String   // 'success' | 'error' | 'timeout'
  errorMsg     String?
  creadoEn     DateTime @default(now())

  client User                 @relation(fields: [clientId], references: [id])
  review PendingTrainerReview?

  @@index([clientId])
  @@index([creadoEn])
}

// Cola de revisión del trainer antes de entregar el plan al cliente.
model PendingTrainerReview {
  id                     String    @id @default(cuid())
  clientId               String
  planGenerationId       String    @unique
  planJson               Json      // GeneratedPlan completo
  proofreaderReportJson  Json?     // ProofreaderReport (rellena en Paso 4)
  proofreaderStatus      String?   // 'aprobado'|'aprobado_con_observaciones'|'rechazado'
  prioridad              String    // 'alta'|'media'|'baja'
  estado                 String    @default("PENDIENTE") // 'PENDIENTE'|'APROBADO'|'RECHAZADO'
  requiereRevisionManual Boolean   @default(false)
  flagsDetectados        String[]  @default([])
  aprobadoPorTrainerId   String?
  aprobadoAt             DateTime?
  entregadoAt            DateTime?
  observacionesResueltas String[]  @default([])
  modificacionesJson     Json?
  creadoEn               DateTime  @default(now())
  actualizadoEn          DateTime  @updatedAt

  client         User           @relation(fields: [clientId], references: [id])
  planGeneration PlanGeneration @relation(fields: [planGenerationId], references: [id])

  @@index([clientId, estado])
  @@index([prioridad, estado])
}

// Planes rechazados en espera de regeneración automática.
model PlanToRegenerate {
  id            String   @id @default(cuid())
  clientId      String
  originalPlanId String?
  motivoRechazo String
  intentosCount Int      @default(0)
  maxIntentos   Int      @default(2)
  estado        String   @default("PENDIENTE") // 'PENDIENTE'|'EN_PROCESO'|'COMPLETADO'|'FALLIDO'
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId, estado])
}

// ─── PAGO (Mercado Pago) ─────────────────────────────────────────────────────
model Payment {
  id           String   @id @default(cuid())
  userId       String
  planTipo     String
  preferenceId String
  paymentId    String?
  status       String   @default("pending")
  amount       Float
  currency     String   @default("ARS")
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  ebookEntrega   EbookEntrega?
}

// ─── LECTOR DE CURSOS — progreso de lectura ─────────────────────────────────
model CursoProgreso {
  id             String   @id @default(cuid())
  userId         String
  slug           String
  ultimoCapitulo String
  completados    String[] @default([])
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, slug])
  @@index([userId])
}

// ─── WEBAUTHN — credenciales biométricas ─────────────────────────────────────
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String[]  @default([])
  creadoEn     DateTime  @default(now())
  ultimoUsoEn  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String
  tipo      String   // "register" | "login"
  email     String?
  userId    String?
  expiresAt DateTime
  creadoEn  DateTime @default(now())
}

// ─── EBOOK / CURSO — entregas pendientes ────────────────────────────────────
// Cuando un cliente paga un ebook (planTipo en ES_EBOOK), se crea un registro
// acá. El trainer ve la lista en /admin/ebooks-pendientes con un botón
// WhatsApp pre-cargado para enviar el PDF y marcar como entregado.
model EbookEntrega {
  id          String    @id @default(cuid())
  userId      String
  paymentId   String    @unique
  planTipo    String    // ebook-rentable | ebook-gluteos | ebook-ryan-humiston
  estado      String    @default("PENDIENTE") // PENDIENTE | ENTREGADO
  entregadoEn DateTime?
  notas       String?
  creadoEn    DateTime  @default(now())
  actualizadoEn DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([estado, creadoEn])
}

// ─── CATÁLOGO DE SUPLEMENTOS RECOMENDADOS (afiliados) ───────────────────────
// Solapa pública /suplementos. Mismo framework que el proyecto de skincare:
// producto + link de afiliado + registro de clics. Un producto solo se muestra
// cuando está activo Y tiene link de afiliado cargado.
model Suplemento {
  id                 String               @id @default(cuid())
  slug               String               @unique // ancla y URL corta: /suplementos/ir/<slug>
  nombre             String // "Creatina monohidrato"
  marca              String? // se completa cuando Ian manda el link
  objetivos          ObjetivoSuplemento[] // en qué solapas aparece
  paraQueSirve       String
  aQuienSeRecomienda String
  comoSeUsa          String // según etiqueta del producto
  linkAfiliado       String?
  imagenUrl          String?
  precioArs          Float?
  relevadoEn         DateTime? // última vez que se chequeó precio/link
  prioridad          Int                  @default(0) // mayor = más arriba
  activo             Boolean              @default(false)
  creadoEn           DateTime             @default(now())
  actualizadoEn      DateTime             @updatedAt

  clicks SuplementoClick[]
}

enum ObjetivoSuplemento {
  ELEMENTOS_BASE // "Lo básico": balanza, cinta, shaker, botella — antes que cualquier suplemento
  GANANCIA_MUSCULAR
  PERDIDA_GRASA
  RENDIMIENTO
  SALUD_GENERAL
}

// Cada clic al link de afiliado pasa por /suplementos/ir/<slug> y queda acá.
model SuplementoClick {
  id           String   @id @default(cuid())
  suplementoId String
  origen       String? // "catalogo" | "documento" | "mail"
  referrer     String?
  creadoEn     DateTime @default(now())

  suplemento Suplemento @relation(fields: [suplementoId], references: [id], onDelete: Cascade)

  @@index([suplementoId, creadoEn])
}

// ─── ALTAS — formulario público de ingreso (/ingreso) ────────────────────────
// Una fila por formulario enviado. Tabla "altas" con columnas snake_case
// (contrato de la especificación) mapeadas a campos camelCase en el cliente.
// RLS activada sin políticas: nadie lee ni escribe desde el rol anónimo.
// La derivación peri-entreno NO se guarda — se recalcula siempre desde los horarios.
model Alta {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  estado   String   @default("nuevo") // nuevo | en_armado | armado | descartado

  // ── Paso 1 — Quién sos ──
  nombre        String
  email         String
  whatsapp      String
  edad          Int
  sexo          String // "Femenino" | "Masculino"
  pesoKg        Decimal @map("peso_kg") @db.Decimal(5, 2)
  alturaCm      Int     @map("altura_cm")
  objetivo      String
  experiencia   String?
  duracionCiclo String? @map("duracion_ciclo")

  // ── Paso 2 — Tus horarios ──
  diasEntrenamiento     String[] @map("dias_entrenamiento") // nombres completos, en orden de semana
  horariosEntrenamiento Json     @map("horarios_entrenamiento") // { "Martes": "11:00", ... }
  horariosComidas       Json     @map("horarios_comidas") // { "desayuno": "09:45", "colacion_am": null, ... }
  comidasSostenibles    Int      @map("comidas_sostenibles")
  ayunas                String
  jornadaVariable       Boolean  @map("jornada_variable")
  jornadaDetalle        String?  @map("jornada_detalle")
  domingo               String?

  // ── Paso 3 — Cómo comés ──
  caeMal        String  @map("cae_mal")
  alergias      String
  noGusta       String  @map("no_gusta")
  cocina        String?
  comidasAfuera String? @map("comidas_afuera")
  balanza       String
  finDeSemana   String? @map("fin_de_semana")
  agua          String?

  // ── Paso 4 — Salud ──
  lesion        Boolean
  lesionDetalle String? @map("lesion_detalle")
  lesionEstado  String? @map("lesion_estado") // "Asintomática" | "Molestias ocasionales" | "Activa"
  laboratorio   String
  medicacion    String
  sueno         String?
  estres        String?
  seguimiento   String?

  // ── Paso 5 — Cómo vas a entrenar ──
  lugar                 String
  equipamiento          String?
  sesionesConEntrenador Int?    @map("sesiones_con_entrenador")
  sesionesSolo          Int?    @map("sesiones_solo")
  duracionSesion        String? @map("duracion_sesion")
  otrosDeportes         String? @map("otros_deportes")
  ejerciciosEvitar      String? @map("ejercicios_evitar")
  pasos                 String?

  // ── Paso 6 — Cómo seguimos ──
  presupuestoSuplementos String  @map("presupuesto_suplementos")
  revision               String?
  comunicacion           String?
  intentosPrevios        String? @map("intentos_previos")
  fechaMotivadora        String? @map("fecha_motivadora")
  consentimiento         Boolean

  // ── Interno — lo escribe el entrenador después ──
  notasInternas String? @map("notas_internas")

  @@index([creadoEn(sort: Desc)])
  @@index([estado])
  @@map("altas")
}

// ─── BIBLIOTECA DE EJERCICIOS ────────────────────────────────────────────────
// Un video por ejercicio. El catálogo vive en src/lib/ejercicios/catalogo.ts;
// el slug de acá es el slug del catálogo.
model EjercicioVideo {
  slug          String   @id
  videoUrl      String
  actualizadoEn DateTime @default(now()) @updatedAt
}
